# OrbitTalent backend environment.
# Copy to .env and fill in.

# Required for LLM scoring. Without it, JD extraction and deep scoring are disabled.
ANTHROPIC_API_KEY=

# SQLite by default (MVP). Swap for a Postgres URL later.
DATABASE_URL=sqlite:///./orbittalent.db

# Comma-separated list of allowed CORS origins (the frontend dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
